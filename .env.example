# Optional -- if set, the login page offers a one-click "Sign in using .env
# credentials" button instead of retyping them every run. Never commit a
# real .env file (it's already in .gitignore).

CX_TENANT=my-tenant
CX_BASE_URL=https://ast.checkmarx.net
CX_IAM_URL=https://iam.checkmarx.net

# Either an API key...
CX_API_KEY=

# ...or a client id/secret pair.
CX_CLIENT_ID=
CX_CLIENT_SECRET=

# api_key | client_credentials (auto-detected from the above if omitted)
CX_AUTH_METHOD=

# Optional: Flask session signing key. A random one is generated per-run if unset.
FLASK_SECRET_KEY=
