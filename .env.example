# Optional -- if set, the login page offers a one-click "Sign in using .env
# credentials" button instead of retyping them every run. Never commit a
# real .env file (it's already in .gitignore).

CX_TENANT=my-tenant
CX_BASE_URL=https://ast.checkmarx.net
CX_IAM_URL=https://iam.checkmarx.net

# Optional: only https://*.checkmarx.net hosts are accepted as base/IAM URLs.
# For a private Checkmarx One instance on another domain, list its hosts here
# (comma-separated; a leading "." allows every subdomain, e.g. .cx.example.com).
CX_ALLOWED_HOSTS=

# Either an API key...
CX_API_KEY=

# ...or a client id/secret pair.
CX_CLIENT_ID=
CX_CLIENT_SECRET=

# api_key | client_credentials (auto-detected from the above if omitted)
CX_AUTH_METHOD=

# Optional: enables "Saved sign-ins" on the login page. Credentials entered
# in the form are encrypted with this key into data/saved_credentials.enc
# (never the tenant databases). Without it, nothing is saved. Generate one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Changing or losing it just means signing in again once per tenant.
CX_CREDENTIALS_KEY=

# Optional: Flask session signing key. A random one is generated per-run if unset.
FLASK_SECRET_KEY=

# Optional: set to 1 only while developing, for auto-reload and in-browser
# tracebacks. Never enable it otherwise -- the debugger can run code.
FLASK_DEBUG=
